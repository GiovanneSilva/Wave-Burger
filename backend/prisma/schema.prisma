// Wave Burger — Prisma schema
//
// Etapa 5: fundação organizacional (Organization/BusinessUnit).
// Nenhuma entidade de Produto, Estoque, Financeiro ou iFood deve ser
// adicionada aqui antes das etapas correspondentes do roteiro.
//
// Convenção obrigatória (ver claude/CLAUDE.md, Seção 3 e 5):
// valores monetários/custo sempre com @db.Decimal, nunca Float.
// IDs de entidades de negócio sempre em UUID (ver claude/CLAUDE.md, Seção 3 e 6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Organização (tenant raiz). Suporta expansão futura para franquias
/// sem exigir reconstrução conceitual (Documento Mestre, OBJ-007).
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  businessUnits BusinessUnit[]
  users         User[]
  auditLogs     AuditLog[]
  ingredients   Ingredient[]
  products      Product[]

  @@map("organizations")
}

/// Unidade de negócio dentro de uma Organization. Deve existir desde a
/// fundação do banco mesmo que o MVP opere com uma única unidade
/// (claude/CLAUDE.md, Seção 3 — "multi-unidade desde o início").
model BusinessUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("business_units")
}

/// Usuário do sistema. Associado a uma Organization (obrigatório) e,
/// opcionalmente, a uma BusinessUnit específica (claude/CLAUDE.md — Etapa 6:
/// "associação do usuário à organização/unidade").
/// Inativado, nunca excluído fisicamente, para preservar rastreabilidade
/// de auditoria (mesmo princípio de RF-003 aplicado por consistência).
model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessUnitId String?  @map("business_unit_id") @db.Uuid
  name           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  roles        UserRole[]
  auditLogs    AuditLog[]
  fichasTecnicasCreated FichaTecnica[]

  @@index([organizationId])
  @@index([businessUnitId])
  @@map("users")
}

/// Perfil que agrupa permissões (RF-029 a RF-032). Perfis iniciais
/// (ADMIN, STOCK_OPERATOR, FINANCE, VIEW_ONLY) são criados via seed —
/// a tabela é aberta para permitir perfis futuros (RF-032) sem migration.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// Permissão granular reutilizável pelo mecanismo central de autorização
/// (claude/CLAUDE.md, Seção 4 — "nenhum módulo de negócio implementa
/// checagem de permissão própria").
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Mecanismo central e reutilizável de auditoria (RF-033, BR-013, BR-015).
/// Nenhum módulo de negócio implementa auditoria própria — todos reutilizam
/// esta tabela via AuditService (claude/CLAUDE.md, Seção 4 e 7).
///
/// Append-only: a migration cria triggers no PostgreSQL que bloqueiam
/// UPDATE/DELETE nesta tabela (claude/CLAUDE.md, Seção 6). Correções são
/// feitas por novos registros, nunca por edição do histórico.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  action         String
  entity         String
  entityId       String   @map("entity_id") @db.Uuid
  previousValue  Json?    @map("previous_value")
  newValue       Json?    @map("new_value")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Ingrediente / matéria-prima (RF-009). Catálogo compartilhado no nível
/// da Organization — não por BusinessUnit — já que receitas/fichas
/// técnicas normalmente são as mesmas entre unidades de uma mesma marca
/// (decisão registrada em claude/CLAUDE.md, Etapa 8; revisar se o negócio
/// precisar de catálogos distintos por unidade no futuro).
///
/// Fonte única da verdade do custo (BR-003) — nenhum outro módulo deve
/// armazenar custo de ingrediente duplicado.
///
/// Campo `currentStock` (RF-009) deliberadamente OMITIDO nesta etapa:
/// é responsabilidade do módulo de Estoque (Etapa 13), que ainda não
/// existe. `minimumStock` é apenas o limite configurado (RF-018), não
/// um saldo.
///
/// `standardUnit` é texto livre validado por uma lista prática no DTO —
/// não resolve PD-011 (conversão de unidades entre compra/ingrediente/
/// ficha técnica), que segue em aberto.
model Ingredient {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String
  category         String?
  standardUnit     String    @map("standard_unit")
  storageLocation  String?   @map("storage_location")
  minimumStock     Decimal?  @map("minimum_stock") @db.Decimal(12, 3)
  averageCost      Decimal?  @map("average_cost") @db.Decimal(12, 4)
  lastCost         Decimal?  @map("last_cost") @db.Decimal(12, 4)
  lastPurchaseDate DateTime? @map("last_purchase_date")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fichaTecnicaItems FichaTecnicaItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("ingredients")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// Produto comercializado (RF-001, RF-002, RF-003).
///
/// BR-001: não pode ser ativado sem ficha técnica válida. Ficha Técnica
/// (Etapa 10) ainda não existe — a checagem é feita através de
/// FichaTecnicaValidationPort (src/products/ficha-tecnica-validation.port.ts),
/// cuja implementação-placeholder atual SEMPRE nega a ativação, para nunca
/// violar BR-001 por omissão. Trocar a implementação na Etapa 10.
///
/// Catálogo no nível da Organization, mesmo critério do Ingredient (Etapa 8).
model Product {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  name                   String
  internalCode           String?       @map("internal_code")
  category               String?
  description            String?
  imageUrl               String?       @map("image_url")
  salePrice              Decimal?      @map("sale_price") @db.Decimal(12, 2)
  promotionalPrice       Decimal?      @map("promotional_price") @db.Decimal(12, 2)
  promotionalPeriodStart DateTime?     @map("promotional_period_start")
  promotionalPeriodEnd   DateTime?     @map("promotional_period_end")
  finalWeight            Decimal?      @map("final_weight") @db.Decimal(10, 3)
  averagePrepTimeMinutes Int?          @map("average_prep_time_minutes")
  isAvailable            Boolean       @default(true) @map("is_available")
  status                 ProductStatus @default(DRAFT)
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fichasTecnicas FichaTecnica[]

  @@unique([organizationId, name])
  @@unique([organizationId, internalCode])
  @@index([organizationId])
  @@index([status])
  @@map("products")
}

/// Ficha Técnica — núcleo funcional do Wave Burger (RF-004 a RF-007).
/// Versionada e IMUTÁVEL por versão: cada alteração de composição cria
/// uma nova linha (nunca UPDATE em uma versão existente), preservando
/// histórico completo (BR-005, claude/CLAUDE.md Seção 4).
///
/// Apenas uma versão por produto tem isCurrent=true — reforçado por
/// índice único parcial no PostgreSQL (ver migration; Prisma não expressa
/// índices parciais na sintaxe estável do schema).
///
/// Os campos de custo/indicador aqui são um SNAPSHOT calculado no momento
/// da criação desta versão (RF-004: "custo utilizado no cálculo"). Para
/// números atualizados com o custo CORRENTE dos ingredientes (BR-004),
/// use FichaTecnicaService.getCurrentCostSummary — que recalcula sob
/// demanda sem jamais reescrever uma versão histórica.
///
/// totalCost = ingredientsCost (soma dos itens). Não inclui custos
/// indiretos (energia, gás, mão de obra) — PD-003 segue sem definição.
model FichaTecnica {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  version          Int
  isCurrent        Boolean  @default(true) @map("is_current")
  ingredientsCost  Decimal  @map("ingredients_cost") @db.Decimal(12, 4)
  totalCost        Decimal  @map("total_cost") @db.Decimal(12, 4)
  cmvPercentage    Decimal? @map("cmv_percentage") @db.Decimal(9, 4)
  markup           Decimal? @db.Decimal(10, 4)
  marginPercentage Decimal? @map("margin_percentage") @db.Decimal(9, 4)
  estimatedProfit  Decimal? @map("estimated_profit") @db.Decimal(12, 4)
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByUser User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  items         FichaTecnicaItem[]

  @@unique([productId, version])
  @@index([productId])
  @@map("fichas_tecnicas")
}

/// Item de composição de uma ficha técnica (RF-004). `costSnapshot` é o
/// custo por unidade padrão do ingrediente, congelado no momento da
/// criação desta versão (BR-005). `unit` deve ser métrica-compatível com
/// o `standardUnit` do ingrediente (kg↔g, l↔ml) — conversões entre
/// famílias diferentes (ex.: kg→un) permanecem bloqueadas por PD-011.
model FichaTecnicaItem {
  id             String  @id @default(uuid()) @db.Uuid
  fichaTecnicaId String  @map("ficha_tecnica_id") @db.Uuid
  ingredientId   String  @map("ingredient_id") @db.Uuid
  quantity       Decimal @db.Decimal(12, 4)
  unit           String
  lossPercentage Decimal @default(0) @map("loss_percentage") @db.Decimal(5, 2)
  costSnapshot   Decimal @map("cost_snapshot") @db.Decimal(12, 4)
  lineCost       Decimal @map("line_cost") @db.Decimal(12, 4)

  fichaTecnica FichaTecnica @relation(fields: [fichaTecnicaId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([fichaTecnicaId])
  @@index([ingredientId])
  @@map("ficha_tecnica_items")
}
