# ==========================================
# Wave Burger — variáveis de ambiente (dev)
# ==========================================

# --- PostgreSQL ---
POSTGRES_USER=waveburger
POSTGRES_PASSWORD=waveburger
POSTGRES_DB=waveburger
POSTGRES_PORT=5432

# --- Backend (NestJS) ---
DATABASE_URL="postgresql://waveburger:waveburger@localhost:5432/waveburger?schema=public"
BACKEND_PORT=3001
NODE_ENV=development
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=8h

# --- Integração iFood (Fase 0/1 — ver claude/ifood-integration-plan.md) ---
# Preencher só depois de completar o cadastro no Portal Developer do
# iFood (exige CNPJ real). Sem essas variáveis, a sincronização de
# catálogo (POST /ifood/catalog/sync) falha com uma mensagem clara.
IFOOD_API_BASE_URL=https://merchant-api.ifood.com.br
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_PORT=3000
